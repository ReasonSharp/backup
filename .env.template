# This file is regenerated on every run of `bkp` (existing values are kept,
# new variables introduced by a newer .env.template are added empty). Edit
# the values here or directly in .env -- both are kept in sync.

# ── Database ─────────────────────────────────────────────────────────────
# Only "mariadb" is supported for now.
DBType="${DBType}"
DBHost="${DBHost}"
DBPort=${DBPort}
DBUser="${DBUser}"
DBPassword="${DBPassword}"
# Password for DBUser when the ephemeral backup containers connect to DBHost
# over the network, if it differs from DBPassword (e.g. a replica where
# root's password is different for a remote/network connection than for a
# local one). Leave empty to just reuse DBPassword for these connections too.
DBRemotePassword="${DBRemotePassword}"
# Host path to MariaDB's actual data directory (bind-mounted read-only during
# backup, and replaced in place during restore) -- this must be the real
# on-disk datadir the running server uses, not a copy of it.
DBDataDir="${DBDataDir}"
# Name of the running MariaDB docker container (stopped/started during restore).
DBContainerName="${DBContainerName}"
# Docker network used to reach DBHost from the ephemeral backup containers.
# Leave empty to use the default bridge network (e.g. when DBHost is reachable
# without a dedicated docker network).
DBDockerNetwork="${DBDockerNetwork}"
# mariadb docker image used to run mariadb-backup/mariadb-binlog -- keep its
# major version matched to the actual MariaDB server version.
DBBackupImage="${DBBackupImage}"
# Where hourly backups get the binlogs needed for point-in-time restore:
#   local  - copy the database's own binlogs from DBDataDir. Use this on a
#            master, or on a replica that runs with log_bin and
#            log_slave_updates (otherwise its binlog doesn't contain the
#            replicated changes). Needs DBBinlogBasename.
#   master - fetch the master's binlogs over the network, using the
#            DBMaster* settings below. Use this on a replica without its own
#            binlog (log_bin=0). Relay logs can't be used instead: the
#            replica deletes them as soon as they're applied.
DBBinlogSource="${DBBinlogSource}"
# Basename of the database's own binlog files, as configured by the server's
# log_bin setting (e.g. "mysql-bin", "mariadb-bin") -- needed when
# DBBinlogSource=local. Not the relay log (e.g. "mysqld-relay-bin").
DBBinlogBasename="${DBBinlogBasename}"

# ── Replication (used by `bkp start-replica`, and by hourly backups when
#    DBBinlogSource=master) ──────────────────────────────────────────────
# Master server this database replicates from, and the replication user on it
# (needs the REPLICATION SLAVE privilege). DBMasterHost must also be reachable
# from the ephemeral backup containers (see DBDockerNetwork) when
# DBBinlogSource=master.
DBMasterHost="${DBMasterHost}"
DBMasterPort=${DBMasterPort}
DBMasterUser="${DBMasterUser}"
DBMasterPassword="${DBMasterPassword}"

# ── Folders ──────────────────────────────────────────────────────────────
# Space-separated list of absolute paths to include in every backup, in
# addition to the database. Leave empty to back up only the database.
BackupFolders="${BackupFolders}"

# ── Local storage ────────────────────────────────────────────────────────
LocalBackupDir="${LocalBackupDir}"
RestoreDir="${RestoreDir}"
# Scratch folder for temporary files: binlogs staged for point-in-time
# restore, and - only for backups made by older bkp versions, which didn't
# save their LSN metadata separately - the unpacked backup a daily
# incremental is based on (needs room for a full unpacked backup). Backups
# and cloud uploads don't use it otherwise. Leave empty to use /tmp, which is
# often a small (or RAM-backed, quota-limited) volume - bkp warns whenever it
# falls back to /tmp.
WorkDir="${WorkDir}"

# ── Cloud storage ────────────────────────────────────────────────────────
# Only "gcloud" is supported for now.
CloudProvider="${CloudProvider}"
GCSBucket="${GCSBucket}"
AESPassphrase="${AESPassphrase}"

# Identifies this machine/environment in backup filenames and cloud paths, so
# multiple instances can safely share one bucket.
BackupInstanceName="${BackupInstanceName}"

# ── Cron schedule (used by `bkp install-cron`) ──────────────────────────
CronWeekly="${CronWeekly}"
CronDaily="${CronDaily}"
CronHourly="${CronHourly}"
LogFile="${LogFile}"
