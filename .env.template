# This file is regenerated on every run of `bkp` (existing values are kept,
# new variables introduced by a newer .env.template are added empty). Edit
# the values here or directly in .env -- both are kept in sync.

# ── Database ─────────────────────────────────────────────────────────────
# Only "mariadb" is supported for now.
DbType="${DbType}"
DbHost="${DbHost}"
DbPort=${DbPort}
DbUser="${DbUser}"
DbPassword="${DbPassword}"
# Host path to MariaDB's actual data directory (bind-mounted read-only during
# backup, and replaced in place during restore) -- this must be the real
# on-disk datadir the running server uses, not a copy of it.
DbDataDir="${DbDataDir}"
# Name of the running MariaDB docker container (stopped/started during restore).
DbContainerName="${DbContainerName}"
# Docker network used to reach DbHost from the ephemeral backup containers.
# Leave empty to use the default bridge network (e.g. when DbHost is reachable
# without a dedicated docker network).
DbDockerNetwork="${DbDockerNetwork}"
# mariadb docker image used to run mariadb-backup/mariadb-binlog -- keep its
# major version matched to the actual MariaDB server version.
DbBackupImage="${DbBackupImage}"
# Basename of the binlog files, as configured by the server's log_bin setting
# (e.g. "mysql-bin", "mariadb-bin") -- required for hourly and point-in-time
# restores.
DbBinlogBasename="${DbBinlogBasename}"

# ── Folders ──────────────────────────────────────────────────────────────
# Space-separated list of absolute paths to include in every backup, in
# addition to the database. Leave empty to back up only the database.
BackupFolders="${BackupFolders}"

# ── Local storage ────────────────────────────────────────────────────────
LocalBackupDir="${LocalBackupDir}"
RestoreDir="${RestoreDir}"

# ── Cloud storage ────────────────────────────────────────────────────────
# Only "gcloud" is supported for now.
CloudProvider="${CloudProvider}"
GcsBucket="${GcsBucket}"
AesPassphrase="${AesPassphrase}"

# Identifies this machine/environment in backup filenames and cloud paths, so
# multiple instances can safely share one bucket.
BackupInstanceName="${BackupInstanceName}"

# ── Cron schedule (used by `bkp install-cron`) ──────────────────────────
CronWeekly="${CronWeekly}"
CronDaily="${CronDaily}"
CronHourly="${CronHourly}"
LogFile="${LogFile}"
