#!/bin/bash

if [[ -t 1 ]]; then
 BOLD=$(tput bold 2>/dev/null || echo '')
 RED=$(tput setaf 1)
 YELLOW=$(tput setaf 3)
 GREEN=$(tput setaf 2)
 CYAN=$(tput setaf 6)
 RESET=$(tput sgr0)
else
 BOLD=
 RED=
 YELLOW=
 GREEN=
 CYAN=
 RESET=
fi

show-help() {
 cat <<EOF
usage: ${BOLD}${0} <command> [params...]${RESET}

 ${CYAN}=================${RESET}
 ${CYAN}= Backup/restore =${RESET}
 ${CYAN}=================${RESET}

  ${BOLD}db-start${RESET}
   - starts ${BOLD}\${DBContainerName}${RESET} if it isn't running, and waits (up to 60s) for it to accept connections
   - reports whether the container failed to start, started but never became healthy, or is up and healthy

  ${BOLD}restart-replication${RESET}
   - stops and starts replication (${BOLD}STOP SLAVE${RESET} / ${BOLD}START SLAVE${RESET}) on ${BOLD}\${DBContainerName}${RESET}
   - does nothing if the database isn't up, or if it isn't configured as a replica
   - reports whether IO/SQL threads end up running, and the last replication error if not

  ${BOLD}start-replica${RESET} [<master-log-file> <master-log-pos>]
   - configures ${BOLD}\${DBContainerName}${RESET} as a replica of ${BOLD}\${DBMasterHost}${RESET} (${BOLD}CHANGE MASTER TO${RESET}) using the ${BOLD}DBMaster*${RESET} settings, then runs ${BOLD}START SLAVE${RESET}
   - without params, resumes from the master's position the last ${BOLD}restore-db-local${RESET} left in ${BOLD}\${DBDataDir}${RESET}: where its replay of the master's binlogs ended, or if it replayed none, the position in the backup (the master's if the backup was made on a replica, otherwise the backed up server's own)
   - that's only right if the master wasn't restored; if it was, pass the binlog position the master's restore logged (also shown by ${BOLD}status${RESET} on the master)
   - does nothing if the database isn't up, or is already configured as a replica (use ${BOLD}restart-replication${RESET} for that)

  ${BOLD}bkp-db-weekly${RESET}
   - performs a weekly (full) backup of the database
   - any existing lower-priority backup processes (daily or hourly) will be terminated
   - the backup stream is compressed with zstd and stored locally in ${BOLD}\${LocalBackupDir}/<timestamp>/mariadb/full${RESET}
   - then uploads to cloud whatever the previous week's chain hasn't uploaded yet, removes that chain locally once it's fully in cloud, and uploads the new full backup

  ${BOLD}bkp-db-daily${RESET} [timestamp]
   - performs a daily (incremental) backup of the database, appending to the latest full backup, or one specified by ${BOLD}[timestamp]${RESET}
   - if a weekly backup is running, this will do nothing
   - if an hourly backup is running it will be terminated before the daily backup starts
   - if there are no previous full backups, or the latest one is older than 8 days, this runs ${BOLD}bkp-db-weekly${RESET} instead and then exits (only when no [timestamp] is given)
   - also runs ${BOLD}bkp-folders${RESET} for the same timestamp
   - the backup stream is compressed with zstd and stored locally in ${BOLD}\${LocalBackupDir}/<timestamp>/mariadb/inc_yyyyMMddHHmmss${RESET}
   - then uploads to cloud the pieces of the chain that aren't there yet (only when no [timestamp] is given)

  ${BOLD}bkp-db-hourly${RESET} [timestamp]
   - performs an hourly (binlog) backup, starting from the binlog active during the last full backup, or the one specified by ${BOLD}[timestamp]${RESET}
   - with ${BOLD}DBBinlogSource=local${RESET}, copies the database's own binlogs (fails if the server's binlog can't be used for point-in-time restore, e.g. a replica without log_bin/log_slave_updates)
   - with ${BOLD}DBBinlogSource=master${RESET}, fetches the master's binlogs over the network (for replicas without their own binlog)
   - if any higher priority backup process (weekly or daily) is running, this will do nothing
   - if there are no previous full backups, or the latest one is older than 8 days, this runs ${BOLD}bkp-db-weekly${RESET} instead (only when no [timestamp] is given)
   - the binlogs are stored locally in ${BOLD}\${LocalBackupDir}/<timestamp>/mariadb/binlogs${RESET}
   - if replication is healthy (IO and SQL threads both running), also purges binlogs on the server older than 14 days (${BOLD}PURGE BINARY LOGS${RESET}); skipped if the database isn't a healthy replica

  ${BOLD}bkp-folders${RESET} <timestamp>
   - backs up the folders configured in ${BOLD}BackupFolders${RESET} to ${BOLD}\${LocalBackupDir}/<timestamp>/files${RESET}

  ${BOLD}bkp-to-cloud${RESET} <timestamp>
   - uploads the backup chain in ${BOLD}\${LocalBackupDir}/<timestamp>${RESET} to ${BOLD}gs://\${GCSBucket}/\${BackupInstanceName}/<timestamp>/${RESET}, one object per piece (full backup, each incremental, each binlog, the backed up folders)
   - only uploads pieces that are new or changed since their last upload (tracked in ${BOLD}.cloud-manifest${RESET} in the chain dir), or missing from cloud
   - each piece is tarred, zstd-compressed, encrypted with ${BOLD}aes-256-cbc${RESET} using ${BOLD}AESPassphrase${RESET} and streamed straight to cloud, using no local disk space
   - an existing cloud object is only replaced once the new upload of that piece succeeds; failed pieces are retried on the next upload
   - waits for any other cloud upload that's still running to finish first
   - logs its progress every 5 minutes (every 30 seconds on a terminal); ${BOLD}upload-status${RESET} shows it any time

  ${BOLD}restore-db-local${RESET} <timestamp> [target-datetime]
   - restores the database from a local backup with the given ${BOLD}timestamp${RESET} in ${BOLD}\${LocalBackupDir}${RESET}
   - replays the saved binlogs up to ${BOLD}[target-datetime]${RESET} (format: yyyy-MM-dd HH:mm:ss, UTC) for a point-in-time restore, or without it, all of them; stops between transactions, never in the middle of one
   - logs the database's binlog position after the restore: replicas restored with the same command start replicating from there (${BOLD}start-replica <file> <pos>${RESET})
   - works with backups made on a master, or on a replica (with ${BOLD}DBBinlogSource=master${RESET}), so a master can be restored from a replica's backup
   - afterwards, the next backup is a full one, starting a new backup chain

  ${BOLD}restore-folders-local${RESET} <timestamp>
   - restores the folders configured in ${BOLD}BackupFolders${RESET} from ${BOLD}\${LocalBackupDir}/<timestamp>/files${RESET}

  ${BOLD}restore-from-cloud${RESET} [target-datetime] [--replace-local-backup] [--from-instance=<name>]
   - downloads the most recent backup chain at or before ${BOLD}[target-datetime]${RESET} (format: yyyy-MM-dd HH:mm:ss, UTC, default: now) from ${BOLD}gs://\${GCSBucket}/${RESET}, decrypts and extracts it into ${BOLD}\${RestoreDir}${RESET} (which must be empty), and moves it into ${BOLD}\${LocalBackupDir}${RESET}
   - also restores single-archive backups uploaded by older bkp versions (needs bzip2)
   - ${BOLD}--from-instance=<name>${RESET} restores another instance's backups instead of ${BOLD}\${BackupInstanceName}${RESET}'s, e.g. a replica's onto its master
   - logs the download progress every 30 seconds on a terminal (every 5 minutes otherwise); ${BOLD}upload-status${RESET} shows it any time

  ${BOLD}install-cron${RESET}
   - installs (or re-installs) weekly/daily/hourly backups as cron jobs, per the ${BOLD}Cron*${RESET} schedule in ${BOLD}.env${RESET}
   - safe to re-run any time: replaces any previously installed entries for this script rather than duplicating them
   - backup to cloud runs automatically after each weekly and daily backup

  ${BOLD}status${RESET}
   - shows which required tools (docker, gcloud, bzip2, ...) are missing, if any, and prints whatever it can check without them
   - shows whether the configured database is reachable, whether the backup cron schedule is installed
   - shows the timestamp and size of the last local backups, the latest backup chain in cloud (its size and last upload time), and how many local pieces aren't uploaded yet
   - if the database is a replica, shows replication status (log files, positions, seconds behind master, last error)
   - shows where binlogs for point-in-time restore come from, the last one saved, and whether the configuration can work
   - shows free space on the volumes holding ${BOLD}\${DBDataDir}${RESET} and ${BOLD}\${LocalBackupDir}${RESET}
   - shows the progress of a running cloud upload or download (see ${BOLD}upload-status${RESET})

  ${BOLD}upload-status${RESET}
   - shows only the progress of a running cloud upload (or download): the chain, the piece going through the archive/compress/encrypt/upload pipeline, how much of it and of the whole upload went through so far, the speed and the time left
   - says so if no upload is running, or if the last one was killed before it finished
   - quick and needs no network, e.g. for ${BOLD}watch -n 5 ./bkp upload-status${RESET}

  ${BOLD}help${RESET} | ${BOLD}""${RESET} | ${BOLD}-h${RESET} | ${BOLD}--help${RESET}
   - displays this help message
EOF
}

get-script-dir() {
 local srcPath="${BASH_SOURCE[0]}"
 local symPath
 local scrPath
 while [ -L "${srcPath}" ]; do
  symPath="$( cd -P "$( dirname "${srcPath}" )" >/dev/null 2>&1 && pwd )"
  srcPath="$(readlink "${srcPath}")"
  if [[ ${srcPath} != /* ]]; then
   srcPath=${symPath}/${srcPath}
  fi
 done
 scrPath="$(cd -P "$( dirname "${srcPath}" )" >/dev/null 2>&1 && pwd)"
 echo "${scrPath}"
}

scriptDir=$(get-script-dir)
export scriptDir

envFile="${scriptDir}/.env"
envTemplate="${scriptDir}/.env.template"

cmd="${1}"
shift

. "${scriptDir}/lib/common.sh"

# status reports missing tools itself, in its own section
[ "${cmd}" != "status" ] && [ "${cmd}" != "upload-status" ] && warn-missing-tools

if [ -f "${envFile}" ]; then
 set -a
 . "${envFile}"
 set +a
fi

[ -z "${DBType}" ] && DBType="mariadb"
[ -z "${DBPort}" ] && DBPort=3306
[ -z "${DBContainerName}" ] && DBContainerName="database"
[ -z "${DBMasterPort}" ] && DBMasterPort=3306
[ -z "${DBBackupImage}" ] && DBBackupImage="mariadb:11.8"
[ -z "${DBBinlogSource}" ] && DBBinlogSource="local"
[ -z "${LocalBackupDir}" ] && LocalBackupDir="${scriptDir}/backups"
[ -z "${RestoreDir}" ] && RestoreDir="${scriptDir}/restored-backup"
[ -z "${CloudProvider}" ] && CloudProvider="gcloud"
[ -z "${BackupInstanceName}" ] && BackupInstanceName="default"
[ -z "${CronWeekly}" ] && CronWeekly="0 0 * * 0"
[ -z "${CronDaily}" ] && CronDaily="0 2 * * 1-6"
[ -z "${CronHourly}" ] && CronHourly="30 * * * *"
[ -z "${LogFile}" ] && LogFile="${scriptDir}/logs/backup.log"

# set defaults, overwrite by values already set in .env by user, then recreate .env with values already loaded + any non-overwritten defaults
set -a
export DBType DBPort DBContainerName DBMasterPort DBBackupImage DBBinlogSource LocalBackupDir RestoreDir CloudProvider BackupInstanceName CronWeekly CronDaily CronHourly LogFile
[ -f "${envFile}" ] && . "${envFile}"
set +a
# without envsubst the redirect alone would truncate .env, losing its values
if command -v envsubst >/dev/null 2>&1; then
 envsubst < "${envTemplate}" > "${envFile}"
fi

mkdir -p "${LocalBackupDir}" "${RestoreDir}" "$(dirname "${LogFile}")"

. "${scriptDir}/lib/backup.sh"

case "${cmd}" in
 bkp-db-weekly)         bkp-db-weekly;;
 bkp-db-daily)          bkp-db-daily "${@}";;
 bkp-db-hourly)         bkp-db-hourly "${@}";;
 bkp-folders)           bkp-folders "${@}";;
 bkp-to-cloud)          bkp-to-cloud "${@}";;
 restore-db-local)      restore-db-local "${@}";;
 restore-folders-local) restore-folders-local "${@}";;
 restore-from-cloud)    restore-from-cloud "${@}";;
 install-cron)          install-cron;;
 db-start)              db-start;;
 restart-replication)   restart-replication;;
 start-replica)         start-replica "${@}";;
 status)                status;;
 upload-status)         upload-status;;
 help|""|-h|--help)
  show-help
  exit 0;;
 *)
  echo "${0}: unknown command '${cmd}'" >&2
  show-help
  exit 1;;
esac
