#!/bin/bash

export liveservices=("cadvisor" "prometheus" "grafana" "loki" "promtail" "alertmanager" "nginx" "gorules-agent" "gorules-editor" "redis" "rabbitmq" "osapi" "dashboard" "weather" "web-api" "live-data-consumer" "plant-data" "sync" "energy-prices" "database" "official-inference" "prefect-worker" "certbot")
export trainservices=("training-vscode" "training-jupyter" "prefect-server" "train-monitoring-prometheus" "train-monitoring-alertmanager" "train-monitoring-node-exporter" "train-monitoring-nvidia-gpu-exporter")

# Dify chatbot stack: run as its own Compose project (-p chatbot), not
# folded into docker.live.yaml -- it's a third-party stack, not
# platform-owned code, so it doesn't fit the liveservices/composeLive
# build+push+is-element pattern above. Defined here (not osai-dev) so it's
# available on both dev and prod, same as docker.live.yaml's own services.
#
# Explicit whitelist, not "every service in the merged compose config" --
# Dify's own nginx/certbot/redis are still defined there (we only dropped
# their dependents' need for them), so anything that calls `up` with no
# service filter must use this list, or it would silently start them too.
chatbotServices=(init_permissions api worker worker_beat web db_postgres weaviate sandbox plugin_daemon ssrf_proxy ollama)

composeChatbot=(-p chatbot -f "${scriptdir}/chatbot/dify/docker/docker-compose.yaml" -f "${scriptdir}/chatbot/docker-compose.override.yaml")
# GPU passthrough for chatbot-ollama only when a GPU is actually usable --
# declaring it unconditionally makes Docker refuse to even create the
# container on a host with no GPU ("failed to discover GPU vendor from CDI").
if command -v nvidia-smi > /dev/null 2>&1 && nvidia-smi > /dev/null 2>&1; then
 composeChatbot+=(-f "${scriptdir}/chatbot/docker-compose.gpu.yaml")
fi
# Dev/test only: publish web/api ports for direct browser access, since
# there's no reverse proxy in front of the stack like prod's nginx.
# chatbot/dify.env's matching absolute localhost URLs come from
# chatbot/dify.env.dev.template, appended by osai under the same condition.
if [ "${env}" = "dev" ] || [ "${env}" = "test" ]; then
 [ -f "${scriptdir}/chatbot/docker-compose.dev.yaml" ] && composeChatbot+=(-f "${scriptdir}/chatbot/docker-compose.dev.yaml")
fi
composeChatbot+=(--env-file "${scriptdir}/chatbot/dify.env")

# `osai` sources the root .env with `set -a`, exporting every var (DB_HOST,
# DB_PORT, DB_PASSWORD, ...) into this shell's real environment. Docker
# Compose gives shell-exported vars top priority for ${VAR} substitution --
# above BOTH --env-file and the compose file's own ${VAR:-default} -- so
# any root .env var whose name happens to collide with one of Dify's ~150
# generic names (confirmed collisions: DB_HOST, DB_PASSWORD, DB_PORT)
# silently overrides chatbot's own config with the platform's real MariaDB
# values. `env -i` runs docker compose with a clean environment instead,
# so only --env-file and Dify's own defaults ever drive substitution.
chatbot-compose() {
 env -i PATH="${PATH}" HOME="${HOME}" ${DOCKER_HOST:+DOCKER_HOST="${DOCKER_HOST}"} ${DOCKER_CONFIG:+DOCKER_CONFIG="${DOCKER_CONFIG}"} \
  docker compose "${composeChatbot[@]}" "${@}"
}

chatbot-down() {
 chatbot-compose down
}

# Ephemeral container (not a permanent bind-mount on chatbot-api itself) that
# runs chatbot/bootstrap.py against the already-up stack: creates the admin
# account, registers the Ollama LLM/embedding model credentials, reconciles
# the knowledge-base dataset (recreating it if a prior run used a different
# embedding model), uploads any knowledge-base/*.md files not yet indexed,
# imports/updates the app DSL, and binds the dataset to the app. Safe to
# re-run -- every step checks current state first. Reaches chatbot-api by
# name on `chatbot_default`, the compose project's own default network
# (project name "chatbot" is fixed via composeChatbot's `-p chatbot` above).
chatbot-bootstrap() {
 docker run --rm --network chatbot_default \
  -v "${scriptdir}/chatbot/knowledge-base:/knowledge-base:ro" \
  -v "${scriptdir}/chatbot/config.yml:/config.yml:ro" \
  -v "${scriptdir}/chatbot/bootstrap.py:/bootstrap.py:ro" \
  -e ADMIN_EMAIL="${CHATBOT_ADMIN_EMAIL}" \
  -e ADMIN_PASSWORD="${CHATBOT_ADMIN_PASSWORD}" \
  -e INIT_PASSWORD="${CHATBOT_INIT_PASSWORD}" \
  python:3.12-slim python3 /bootstrap.py
}

chatbot-update() {
 # No registry.clab.hr login: every chatbot image is pulled straight from
 # its upstream public registry (Docker Hub etc.), unlike osapi/web-api.
 local services=("${@}")
 [ ${#services[@]} -eq 0 ] && services=("${chatbotServices[@]}")
 chatbot-compose pull "${services[@]}"
 chatbot-compose up -d --no-build --force-recreate "${services[@]}"

 # The platform's own nginx (docker.live.yaml) proxies to chatbot-api/web by
 # container name over the `os` network. Nginx only resolves that name to an
 # IP once, at worker-process start -- --force-recreate above just gave those
 # containers new IPs, so without a reload nginx keeps dialing the old ones
 # and every request 502s until something happens to reload it.
 if docker inspect nginx > /dev/null 2>&1; then
  docker exec nginx nginx -s reload
 fi

 # chatbot-api has no Docker HEALTHCHECK (docker-compose.yaml declares none),
 # so there's no container-level readiness signal to poll here -- actual
 # readiness (can it answer HTTP requests yet) is instead retried inside
 # chatbot/bootstrap.py's own first call, where a real check is possible.
 if docker inspect chatbot-ollama > /dev/null 2>&1; then
  docker exec chatbot-ollama ollama pull jobautomation/OpenEuroLLM-Croatian
  docker exec chatbot-ollama ollama pull snowflake-arctic-embed2
 else
  echo "upozorenje: chatbot-ollama ne postoji — modeli nisu preuzeti, chatbot-bootstrap će vjerojatno pući" >&2
 fi

 chatbot-bootstrap

 if [ "${env}" != "dev" ] && [ "${env}" != "test" ]; then
  echo "podsjetnik: 'sudo ufw deny 11434' da ollama ostane dostupan samo lokalno (ako već nije postavljeno)"
 fi
}

get-param() {
 local mandatory="${1}"
 local name="${2}"
 shift; shift
 if [ -z "${mandatory}" ] || [ -z "${name}" ]; then
  echo "greška: prva dva parametra funkcije get-param su obavezna"
  exit 1
 fi
 value=
 defaultvalue=
 while [ ! -z "${1}" ]; do
  local nvalue="${1}"
  if [[ "${nvalue}" == "-v" ]]; then
   value="${2}"
   shift; shift
  elif [[ "${nvalue}" == "-d" ]]; then
   defaultvalue="${2}"
   shift; shift
  else
   echo "greška: nepoznata opcija ${nvalue}"
   exit 1
  fi
 done
 result=
 if [ -z "${value}" ] && [ ! "${mandatory}" -eq 0 ]; then
  if [ -z "${defaultvalue}" ]; then
   echo "greška: parametar ${name} je obavezan"
   exit 1
  else
   result="${defaultvalue}"
  fi
 elif [ -z "${value}" ] && [ "${mandatory}" -eq 0 ]; then
  if [ ! -z "${defaultvalue}" ]; then
   result="${defaultvalue}"
  fi
 else
  result="${value}"
 fi
 echo "${result}"
}

is-element() {
 local needle="${1}"
 shift
 local haystack=("${@}")
 for item in "${haystack[@]}"; do
  if [[ "${item}" == "${needle}" ]]; then
   return 0
  fi
 done
 return 1
}
